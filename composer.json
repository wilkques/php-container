{
    "name": "wilkques/container",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=5.3",
        "psr/container": ">=1.0 <1.1"
    },
    "provide": {
        "psr/container-implementation": "1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Wilkques\\Container\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wilkques\\Container\\Tests\\": "tests"
        }
    }
}
